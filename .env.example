# =====================================================================
# GULNAAR by MK — Environment Configuration
# Copy this file to .env.local and populate with your Supabase credentials
# =====================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for browser usage with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-ONLY — NEVER expose to the browser)
# Used exclusively for administrative actions and background processing
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

